# Secrets and local settings — never commit these. The example file documents what goes in them.
.env
.env.*
!.env.example
# The made-up project the browser tests run against, and the template for a real one
!web/.env.emulators
!web/.env.cloud.example

# Xcode
*.xcodeproj
xcuserdata/
DerivedData/
build/
*.xcuserstate

# Generated by XcodeGen from ios/project.yml
ios/GymTracker/Info.plist
ios/GymTracker/GymTracker.entitlements
ios/ShareExtension/Info.plist
ios/ShareExtension/ShareExtension.entitlements

# Analyzer server
.venv/
# Tokens for Strava and Garmin Connect, and the list of workouts already sent
server/connections.json
server/garmin-tokens/
# Links shared from other apps, waiting for the web app
server/inbox.json
# A store file on its way to replacing one of the two above
server/*.tmp
__pycache__/
.pytest_cache/

# macOS
.DS_Store

# The version with accounts (cloud/)
web/dist-cloud/
web/dist-emulators/
# Which Firebase project this checkout deploys to
cloud/.firebaserc
cloud/.firebase/
cloud/firebase.e2e.json
cloud/*.log
