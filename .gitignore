# Secrets and local settings — never commit these. The example file documents what goes in them.
.env
.env.*
!.env.example

# Xcode
*.xcodeproj
xcuserdata/
DerivedData/
build/
*.xcuserstate

# Generated by XcodeGen from ios/project.yml
ios/GymTracker/Info.plist
ios/GymTracker/GymTracker.entitlements
ios/ShareExtension/Info.plist
ios/ShareExtension/ShareExtension.entitlements

# Analyzer server
.venv/
# Tokens for Strava and Garmin Connect, and the list of workouts already sent
server/connections.json
server/connections.tmp
server/garmin-tokens/
# Links shared from other apps, waiting for the web app
server/inbox.json
server/inbox.tmp
__pycache__/
.pytest_cache/

# macOS
.DS_Store
