# Settings for analyzer.py. Copy this file to server/.env and uncomment what you need.
# server/.env is ignored by git: real keys never belong in the repository.

# The key of the service that should name the exercises. One is enough.
# ANTHROPIC_API_KEY=sk-ant-...
# ZAI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...

# Which service to use when more than one key is set: anthropic, zai, openrouter or gemini.
# ANALYZER_PROVIDER=gemini

# Another model of that service; each service has a default.
# ANALYZER_MODEL=gemini-3-flash-preview

# Instagram often refuses anonymous downloads. This lets yt-dlp use the login
# of a browser you are signed in with: safari, chrome, firefox…
# YTDLP_COOKIES_FROM_BROWSER=safari

# Only when the web version is hosted somewhere else and calls in from there.
# ALLOWED_ORIGINS=https://example.github.io
