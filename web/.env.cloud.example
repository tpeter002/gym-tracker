# Settings of the version with accounts. Copy to .env.cloud.local (which git
# ignores) and fill in; `npm run build:cloud` reads it. cloud/README.md says
# where each value comes from.
#
# These identify the Firebase project; they are not secrets — every visitor's
# browser receives them. What protects the data is cloud/firestore.rules.

# Project settings → Your apps → the web app's configuration
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Shown in "Where your data is kept": who runs this copy and how to reach them,
# and where the database is (the location chosen when it was created).
VITE_OPERATOR=
VITE_DATA_REGION=
